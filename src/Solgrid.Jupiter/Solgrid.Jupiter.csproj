<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Solgrid.Jupiter</PackageId>
    <Version>0.1.0</Version>
    <Authors>Solgrid</Authors>
    <Company>Solgrid</Company>
    <Product>Solgrid.Jupiter</Product>
    <Description>Jupiter DeFi API client for .NET on Solana: swap quotes (Swap V2 /order, /build, /execute), token prices (Price V3), token metadata (Tokens V2) and portfolio positions (Portfolio V1). Pure HTTP client on System.Text.Json with throttling, 429 retry and drift-tolerant models.</Description>
    <PackageTags>solana;jupiter;defi;dex;swap;aggregator;price;tokens;portfolio;blockchain;crypto</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Solgrid.Jupiter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
